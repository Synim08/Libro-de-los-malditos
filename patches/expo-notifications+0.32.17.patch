+import expo.modules.notifications.service.delegates.ExpoSchedulingDelegate
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.concurrent.thread
+
+/**
+ * Handles exact scheduled notifications in a short-lived, isolated process.
+ *
+ * Using a service PendingIntent avoids vendor broadcast queues that can retain an alarm
+ * receiver until the screen wakes. AlarmManager temporarily allowlists the application
+ * while delivering this PendingIntent, so the service can finish the notification work
+ * immediately and then terminate its process.
+ */
+class ExactNotificationTriggerService : Service() {
+  override fun onBind(intent: Intent?): IBinder? = null
+
+  override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+    val identifier = intent?.getStringExtra(IDENTIFIER_EXTRA)
+    val data = intent?.data
+
+    if (identifier == null || data == null || intent.action != ACTION || !isValidTriggerUri(data, identifier)) {
+      Log.w(TAG, "Ignoring an invalid exact-notification trigger")
+      stopSelf(startId)
+      return START_NOT_STICKY
+    }
+
+    startDeliveryForeground()
+    activeWork.incrementAndGet()
+    Log.i(TAG, "Received exact notification trigger $identifier")
+    thread {
+      try {
+        ExpoSchedulingDelegate(applicationContext).triggerNotification(identifier)
+        Log.i(TAG, "Finished exact notification trigger $identifier")
+      } catch (exception: Exception) {
+        Log.e(TAG, "Could not trigger exact notification $identifier", exception)
+      } finally {
+        stopForeground(STOP_FOREGROUND_REMOVE)
+        stopSelfResult(startId)
+        if (activeWork.decrementAndGet() == 0) {
+          // Avoid leaving a cached process for vendor ROMs to freeze between alarms.
+          Thread.sleep(250)
+          if (activeWork.get() == 0) {
+            Process.killProcess(Process.myPid())
+          }
+        }
+      }
+    }
+    return START_NOT_STICKY
+  }
+
+  private fun startDeliveryForeground() {
+    val manager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+      manager.createNotificationChannel(
+        NotificationChannel(
+          DELIVERY_CHANNEL_ID,
+          "Entrega de recordatorios",
+          NotificationManager.IMPORTANCE_LOW
+        ).apply {
+          description = "Mantiene activo el aviso solo mientras se entrega"
+          setShowBadge(false)
+        }
+      )
+    }
+
+    val notification = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+      Notification.Builder(this, DELIVERY_CHANNEL_ID)
+    } else {
+      @Suppress("DEPRECATION")
+      Notification.Builder(this)
+    }
+      .setSmallIcon(applicationInfo.icon)
+      .setContentTitle("Libro de los Malditos")
+      .setContentText("Preparando recordatorio…")
+      .setCategory(Notification.CATEGORY_SERVICE)
+      .setOngoing(true)
+      .setShowWhen(false)
+      .build()
+
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+      startForeground(
+        DELIVERY_NOTIFICATION_ID,
+        notification,
+        ServiceInfo.FOREGROUND_SERVICE_TYPE_SHORT_SERVICE
+      )
+    } else {
+      startForeground(DELIVERY_NOTIFICATION_ID, notification)
+    }
+  }
+
+  companion object {
+    private const val TAG = "expo-notifications"
+    private const val ACTION = "expo.modules.notifications.EXACT_NOTIFICATION_TRIGGER"
+    private const val IDENTIFIER_EXTRA = "identifier"
+    private const val DELIVERY_CHANNEL_ID = "expo_scheduled_notification_delivery"
+    private const val DELIVERY_NOTIFICATION_ID = 731947
+    private val activeWork = AtomicInteger(0)
+
+    fun createIntent(context: Context, identifier: String): Intent =
+      Intent(context, ExactNotificationTriggerService::class.java).apply {
+        action = ACTION
+        data = Uri.parse("expo-notifications://notifications/scheduled/$identifier/trigger")
+        putExtra(IDENTIFIER_EXTRA, identifier)
+      }
+
+    private fun isValidTriggerUri(uri: Uri, identifier: String): Boolean =
+      uri.scheme == "expo-notifications" &&
+        uri.host == "notifications" &&
+        uri.pathSegments == listOf("scheduled", identifier, "trigger")
+  }
+}
